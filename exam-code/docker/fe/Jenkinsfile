pipeline {
    agent any
    // agent {
    //     docker {
    //         image 'python:3.10'
    //     }
    // }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub-creds')
        DOCKER_REGISTRY = 'yamlevene'
        REPO_NAME = 'fe-exam'  // Change to 'be-exam' for backend pipeline
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        HELM_REGISTRY = 'oci://your-helm-registry'
    }
    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'workshop/argo-jenkins-exam', url: 'https://github.com/yamlevene/devopshift-welcome.git'
            }
        }
        
        stage('Lint & Security Scan') {
            parallel {
                stage('Flake8 Linting') {
                    steps {
                        script {
                            sh 'pip install --user flake8 || echo "Flake8 is already installed"'
                            sh 'flake8 exam-code/docker/be/src/mainbe.py'
                        }
                    }
                }

                stage('Bandit Security Scan') {
                    steps {
                        script {
                            sh 'pip install --user bandit || echo "Bandit is already installed"'
                            sh 'bandit -r exam-code/docker/fe/src/'
                        }
                    }
                }
            }
        }

        
        stage('Install Dependencies') {
            steps {
                sh 'pip install -r devopshift-welcome/exam-code/docker/fe/requirements.txt'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                sh "docker build -t $DOCKER_REGISTRY/$REPO_NAME:$IMAGE_TAG -f devopshift-welcome/exam-code/docker/fe/Dockerfile ."
                sh "docker tag $DOCKER_REGISTRY/$REPO_NAME:$IMAGE_TAG $DOCKER_REGISTRY/$REPO_NAME:latest"
            }
        }
        
        stage('Run Tests in Container') {
            steps {
                sh "docker run --rm $DOCKER_REGISTRY/$REPO_NAME:$IMAGE_TAG pytest devopshift-welcome/exam-code/docker/fe/src/tests/"
            }
        }
        
        stage('Integration Test with Docker Compose') {
            steps {
                sh 'docker-compose -f devopshift-welcome/exam-code/docker/docker-compose.yaml up -d'
                sleep time: 10, unit: 'SECONDS'  // Wait for services to start
                sh 'curl -f http://localhost:5002 || exit 1'  // Adjust port for backend if needed
                sh 'docker-compose -f devopshift-welcome/exam-code/docker/docker-compose.yaml down'
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                sh "echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin"
                sh "docker push $DOCKER_REGISTRY/$REPO_NAME:$IMAGE_TAG"
                sh "docker push $DOCKER_REGISTRY/$REPO_NAME:latest"
            }
        }
        
        // stage('Update Helm OCI Chart') {
        //     steps {
        //         sh 'helm registry login $HELM_REGISTRY --username $DOCKERHUB_CREDENTIALS_USR --password $DOCKERHUB_CREDENTIALS_PSW'
        //         sh "helm package helm-chart && helm push helm-chart-*.tgz $HELM_REGISTRY"
        //     }
        // }
    }
}
